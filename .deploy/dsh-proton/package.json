{
  "name": "dsh-proton",
  "version": "0.1.3",
  "description": "质子 —— DSH 的通用 Region / Renderer / Decorator 运行时（不含任何产品域语义）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-proton.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-proton#readme",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {}
}
