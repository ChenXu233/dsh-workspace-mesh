{
  "name": "dsh-workspace-mesh",
  "version": "0.2.0",
  "description": "Workspace mesh for DeepSeek Harness: declare which workspace lives on which host, dispatch tasks by workspace across paired DSH instances, and control the remote host lifecycle. The agent loop never leaves the owning machine.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SPEC.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "workspace",
    "federation",
    "dispatch",
    "remote",
    "multi-host",
    "swarm",
    "cordis-plugin"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "ChenXu233",
    "url": "https://github.com/ChenXu233"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-workspace-mesh.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-workspace-mesh#readme",
  "bugs": {
    "url": "https://github.com/ChenXu233/dsh-workspace-mesh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {}
}
