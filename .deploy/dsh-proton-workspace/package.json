{
  "name": "dsh-proton-workspace",
  "version": "0.1.3",
  "description": "质子 · 工作区域：目录流的选择与接纳，来源由任意 backend 通过 ctx.protonWorkspace 注册",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-proton.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-proton#readme",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-proton",
        "dsh-proton-adapter-dsh"
      ]
    }
  },
  "dependencies": {
    "dsh-proton": "0.1.3",
    "dsh-proton-adapter-dsh": "0.1.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
