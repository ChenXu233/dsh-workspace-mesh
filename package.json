{
  "name": "dsh-workspace-mesh",
  "version": "0.1.0",
  "description": "Workspace mesh for DeepSeek Harness: declare which workspace lives on which host, dispatch tasks by workspace across paired DSH instances, and control the remote host lifecycle. The agent loop never leaves the owning machine.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "SPEC.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "workspace",
    "federation",
    "dispatch",
    "remote",
    "multi-host",
    "swarm",
    "cordis-plugin"
  ],
  "license": "MIT",
  "scripts": {
    "build": "pnpm gen:schema && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/test/*.test.js\"",
    "clean": "node -e \"for (const d of ['lib','lib-test']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "gen:schema": "node scripts/gen-config-schema.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
