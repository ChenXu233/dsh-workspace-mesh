+/**
+ * A Workspace row that lives on another machine.
+ *
+ * Reuses the shipment's row layout, lead-slot swap and hover card, but it has
+ * no local Workspace identity: there is no menu, no create action and no drag.
+ * The globe replaces the folder and the machine suffix names the owner; the
+ * expansion state and session count still come from the group node.
+ * @param props.group - remote group node carrying `remote`.
+ * @param props.containsCurrentDescendant - highlight an ancestor whose subtree
+ *   contains the open conversation.
+ * @param props.onToggle - expand/collapse the remote group.
+ * @param props.t - the workspace locale seat.
+ * @returns the remote Workspace row.
+ */
+export function RemoteProjectRowItem({ group, containsCurrentDescendant = false, onToggle, t }: {
+  group: GroupNode
+  containsCurrentDescendant?: boolean
+  onToggle: () => void
+  t: RowTranslate
+}) {
+  const remote = group.remote
+  if (remote === undefined) throw new Error('RemoteProjectRowItem requires group.remote')
+  const active = containsCurrentDescendant || (group.expanded && group.containsCurrent)
+  const ownRow = (
+    <div
+      className={css.projectRow}
+      data-row-key={`workspace:${group.key}`}
+      role="treeitem"
+      aria-expanded={group.expanded}
+      onClick={onToggle}
+    >
+      <span className={clsx(css.slot, css.folder, active && css.folderActive)}>
+        <IconGlobeOutlineRegular className={clsx(!remote.online && css.offline)} />
+      </span>
+      <span className={clsx(css.slot, css.chevron)}>
+        <IconTriangleRightFillRegular className={clsx(css.arrow, group.expanded && css.arrowOpen)} />
+      </span>
+      <span className={css.projectText}>
+        <span className={css.title}>
+          {group.label}
+          <span className={css.machine}>{'@' + remote.nodeLabel}</span>
+        </span>
+      </span>
+    </div>
+  )
+  return (
+    <HoverCard
+      anchor={ownRow}
+      content={<WorkspaceHoverContent
+        label={group.label}
+        cwd={group.cwd}
+        createdAt={group.createdAt}
+        remote={remote}
+        t={t}
+      />}
+      openDelayMs={800}
+      grouped
+      copyText={remote.remotePath}
+      copyLabel={t('copy')}
+      copiedLabel={t('hover.copied')}
+    />
+  )
+}
