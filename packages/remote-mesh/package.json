{
  "name": "dsh-workspace-mesh",
  "version": "0.3.4",
  "description": "Workspace mesh for DeepSeek Harness: declare which workspace lives on which host, dispatch tasks by workspace across paired DSH instances, and control the remote host lifecycle. The agent loop never leaves the owning machine.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SPEC.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mesh",
    "workspace",
    "federation",
    "dispatch",
    "remote",
    "multi-host",
    "swarm",
    "cordis-plugin"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "ChenXu233",
    "url": "https://github.com/ChenXu233"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenXu233/dsh-workspace-mesh.git"
  },
  "homepage": "https://github.com/ChenXu233/dsh-workspace-mesh#readme",
  "bugs": {
    "url": "https://github.com/ChenXu233/dsh-workspace-mesh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm gen:schema && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/test/*.test.js\"",
    "clean": "node -e \"for (const d of ['lib','lib-test']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "verify": "pnpm build && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm build",
    "gen:schema": "node scripts/gen-config-schema.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.10.0",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  }
}
